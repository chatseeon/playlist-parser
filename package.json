{
  "name": "playlist-parser",
  "version": "1.0.0",
  "description": "歌单解析器：把歌单整理成文字歌单并备份到 GitHub（Windows 便携版）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "needle": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.playlistparser",
    "productName": "歌单解析器",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "extraResources": [
      "THIRD-PARTY-NOTICES.txt",
      "licenses/**/*"
    ]
  },
  "license": "Apache-2.0"
}
